    "employee_groups": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "office_id", "department_id", "sub_department_id", "name"] } },

    "timetables": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "name"] } },
    "shifts": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "name"] } },
