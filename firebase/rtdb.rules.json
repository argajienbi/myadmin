    "holidays": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "date", "type"] } },
    "schedule_specials": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "date", "type", "target_id", "shift_id"] } },
    "schedule_change_logs": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["created_at", "target_type", "target_id", "admin_uid"] } },

    "attendance": {
