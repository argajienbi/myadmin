{
  "rules": {
    ".read": false,
    ".write": false,

    "app_config": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (auth.uid === $uid && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('role').val() === 'user' && newData.child('status_akun').val() === 'pending') || (data.exists() && newData.child('uid').val() === auth.uid && newData.child('role').val() === data.child('role').val() && newData.child('company_id').val() === data.child('company_id').val() && newData.child('status_akun').val() === data.child('status_akun').val() && newData.child('position').val() === data.child('position').val()))))",
        ".indexOn": ["company_id", "role", "position", "status_akun", "email"]
      }
    },

    "companies": {
      "$companyId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".indexOn": ["active", "admin_uid", "code"]
      }
    },

    "company_invites": {
      "$inviteCode": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".indexOn": ["company_id", "active", "expired_at"]
      }
    },

    "company_users": {
      "$companyId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)",
        ".indexOn": ["status_akun", "role", "position", "area_id", "office_id", "department_id", "sub_department_id", "group_id", "email", "nip"],
        "$uid": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId) || (auth.uid === $uid && root.child('users').child(auth.uid).child('company_id').val() === $companyId && data.exists() && newData.child('uid').val() === auth.uid && newData.child('role').val() === data.child('role').val() && newData.child('status_akun').val() === data.child('status_akun').val() && newData.child('position').val() === data.child('position').val() && newData.child('area_id').val() === data.child('area_id').val() && newData.child('office_id').val() === data.child('office_id').val() && newData.child('department_id').val() === data.child('department_id').val() && newData.child('sub_department_id').val() === data.child('sub_department_id').val() && newData.child('group_id').val() === data.child('group_id').val()))"
        }
      }
    },

    "areas": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "name"] } },
    "offices": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "area_id", "name"] } },
    "departments": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "office_id", "name"] } },
