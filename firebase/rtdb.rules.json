        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)",
        ".indexOn": ["tanggal", "action_type", "attendance_status", "method", "created_at"],
        "$uid": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId) || (auth.uid === $uid && root.child('users').child(auth.uid).child('company_id').val() === $companyId))"
        }
      }
    },
    "leave_requests": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".indexOn": ["uid", "status", "leave_type", "tanggal_mulai", "tanggal_selesai", "created_at"] } },
    "qr_attendance_requests": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".indexOn": ["helper_uid", "target_uid", "status", "tanggal", "created_at"] } },
    "attendance_corrections": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["uid", "tanggal", "status", "created_at"] } },
    "announcements": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["active", "target_type", "target_id", "created_at"] } },
    "audit_logs": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["created_at", "user_uid", "action"] } },
    "notifications": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null", ".indexOn": ["company_id", "is_read", "created_at", "type"] } },
    "report_cache": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('company_id').val() === $companyId))", ".indexOn": ["updated_at"] } },
    "storage_index": { "$companyId": { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('company_id').val() === $companyId)", ".indexOn": ["uploaded_at"] } }
